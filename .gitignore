
Thumbs.db
**/Thumbs.db

# Python build artifacts + local backup copies (not source)
__pycache__/
**/__pycache__/
*.pyc
pharmacy_server/backup_files/

# ── Pharmacy server: production-written data (never overwrite from git) ──────
# All runtime data under pharmacy_server/data is server-written. New files must
# never be tracked. Files already committed stay tracked (ignore rules don't
# untrack); this only stops *new* untracked files from showing up.
# Ignore the sensitive/runtime subfolders individually rather than all of
# data/, so the reference collections (rx/, ks/) can be versioned. Listing
# the parent would stop git descending at all and no !negation could work.
pharmacy_server/data/patients/
pharmacy_server/data/hmr/
pharmacy_server/data/hmq/
pharmacy_server/data/opd-queue/
pharmacy_server/data/auth/
pharmacy_server/data/logs/
pharmacy_server/data/report-cache/
pharmacy_server/data/ext-pkg/
pharmacy_server/data/med-images/
pharmacy_server/data/users.json
# Monthly shift-roster snapshots the server writes (state-YYYY-MM.json).
# state.json + bookings.json stay tracked — they were committed long ago
# and the app reads them as reference; the dated snapshots are runtime.
pharmacy_server/data/schedule/state-*.json
# (kept explicit for clarity)
pharmacy_server/data/kpi/
# Temporary Jasper report downloads
pharmacy_server/data/temp-reports/

# Sample report exports dropped at repo root for local testing — contain real
# patient data (name/HN/ward), never commit.
/*.xls
/*.xlsx
# The IV master worksheets carry the live ward list — real HN, name and
# room for every inpatient on IV antibiotics. Reference data was extracted
# from them into src/features/iv-worklist/iv-drug-db.js (drugs only, no
# patients); the workbooks themselves must never be committed.
/IV_ATB_Master*.csv
/IV_ATB_Master*.xlsx

# ── Stale nested copies of the repo (accidental backup/copy-paste) ───────────
# Real source lives at BKNPharmacyPortal/ and pharmacy_server/. These nested
# duplicates are frozen at old versions (v3.8.5 / v3.46.1 vs current) and must
# never be committed.
BKNPharmacyPortal/BKNPharmacyPortal/
pharmacy_server/BKNPharmacyPortal/
pharmacy_server/pharmacy_server/

# Separate project with its own git remote (shivavamaki/Pharmacy_Student_game)
Pharmacy_Student_game/

# Windows shortcuts and stray local scratch files
*.lnk
pharmacy_server/www/static/0..png

# ── Reference data: safe to version (no patient identifiers) ─────────────────
# data/ is ignored wholesale above because it is production-written and holds
# patient records. These two collections are clinical REFERENCE data — drug
# database, mixing protocols, frequency master, FAQs — maintained by the
# pharmacists and worth keeping in history. Verified free of HN/name/patientuid.
# NOTE: never un-ignore patients/, hmr/, hmq/, opd-queue/, temp-reports/, logs/
# or auth/ — those carry identifiable patient data and credential hashes.
