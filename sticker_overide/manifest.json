{
  "manifest_version": 3,
  "name": "Jasper Sticker Rebuilder",
  "version": "0.1.5",
  "version_name": "2026.05.17 - refactor content script into modules, fix renderer tab reuse",
  "description": "Captures JasperServer ipdsticker XLS output via the extension background, parses it locally, and rebuilds a printable sticker layout with QR codes.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://aa-report.bdms.co.th/*",
    "https://aa-report-uat.bdms.co.th/*",
    "https://arcusair.bdms.co.th/*"
  ],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aa-report.bdms.co.th/jasperserver/*",
        "https://aa-report-uat.bdms.co.th/jasperserver/*",
        "https://arcusair.bdms.co.th/*"
      ],
      "js": [
        "src/libs/jszip.min.js",
        "src/libs/xlsx.full.min.js",
        "src/content/shared.js",
        "src/content/parser.js",
        "src/content/capture.js",
        "src/content/panel.js",
        "src/content/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/*",
        "src/libs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Jasper Sticker Rebuilder",
    "default_popup": "src/pages/popup.html"
  }
}
