{
  "manifest_version": 3,
  "name": "Arcus Toolkit",
  "version": "4.7.0",
  "version_name": "2026-09-14 - Tab-local settings and persistent running panels",
  "description": "Auto Dispense and IP Fill automation for Arcus Pharmacy Management System.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://arcusair.bdms.co.th/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arcusair.bdms.co.th/*"
      ],
      "js": [
        "content/tab-settings.js",
        "content/panel-host.js",
        "content/api-client.js",
        "content/driver.js",
        "content/shared.js",
        "content/auto-override.js",
        "content/panel.js",
        "content/automation.js",
        "content/boot.js",
        "content/ipfill_panel.js",
        "content/drug-image.js",
        "content/frequency-master.js",
        "content/order-item.js",
        "content/translation.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arcusair.bdms.co.th/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://arcusair.bdms.co.th/*"
      ]
    }
  ]
}
