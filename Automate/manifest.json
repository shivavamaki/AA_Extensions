{
  "manifest_version": 3,
  "name": "Arcus Toolkit",
  "version": "4.2.0",
  "version_name": "2026.06.15 — Auto Dispense and IP Fill automation panel",
  "description": "Auto Dispense and IP Fill automation for Arcus Pharmacy Management System.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://arcusair.bdms.co.th/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arcusair.bdms.co.th/*"
      ],
      "js": [
        "content/shared.js",
        "content/panel.js",
        "content/automation.js",
        "content/boot.js",
        "content/ipfill_panel.js",
        "content/drug-image.js",
        "content/frequency-master.js",
        "content/order-item.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
